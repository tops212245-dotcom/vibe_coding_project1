    {
      "name": "05. Booking & Appointments",
      "item": [
        {
          "name": "Check Provider Time Slots",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{customerToken}}"}],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/bookings/slots?provider_id=1&date=2026-11-10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings", "slots"],
              "query": [
                {"key": "provider_id", "value": "1"},
                {"key": "date", "value": "2026-11-10"}
              ]
            }
          }
        },
        {
          "name": "Create Appointment Booking",
