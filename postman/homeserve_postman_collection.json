              "raw": "{\n  \"provider_id\": 1,\n  \"service_id\": 1,\n  \"address_id\": 1,\n  \"scheduled_date\": \"2026-11-10\",\n  \"scheduled_time_slot\": \"10:00 - 12:00\",\n  \"customer_notes\": \"Please check living room master switch circuit.\",\n  \"coupon_code\": \"WELCOME50\"\n}"
            },
