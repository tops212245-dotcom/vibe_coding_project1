# HomeServe Technologies — Environment Configuration
PROJECT_NAME="HomeServe Technologies"
ENVIRONMENT="development"
DEBUG=True

# API Configuration
API_V1_PREFIX="/api/v1"
SECRET_KEY="super-secret-development-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (MySQL / SQLite fallback)
# For local MySQL: mysql+pymysql://root:password@localhost:3306/homeserve_db
# For SQLite fallback during offline development: sqlite:///./homeserve.db
DATABASE_URL="sqlite:///./homeserve.db"

# Admin Bootstrap (automatically provisioned on startup if users table is empty)
FIRST_SUPERADMIN_EMAIL="admin@homeserve.com"
FIRST_SUPERADMIN_PASSWORD="AdminPassword123!"
FIRST_SUPERADMIN_FIRSTNAME="Platform"
FIRST_SUPERADMIN_LASTNAME="Admin"

# CORS Configuration (comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Razorpay Test Gateway Configuration
RAZORPAY_KEY_ID="rzp_test_YourTestKeyId"
RAZORPAY_KEY_SECRET="YourRazorpayTestSecretKey"
PAYMENT_SIMULATION_ENABLED=True

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="demo-cloud"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# SMTP Email Configuration (optional)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="support@homeserve.local"
EMAILS_ENABLED=False

