# ==============================================================================
# HomeServe Technologies — Master Environment Configuration Template
# ==============================================================================

# ----------------- Backend Configuration (backend/.env) -----------------
PROJECT_NAME="HomeServe Technologies"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# JWT Authentication
SECRET_KEY="super-secret-development-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (MySQL Production or Local SQLite fallback)
# MySQL: mysql+pymysql://user:password@hostname:3306/homeserve_db
# SQLite: sqlite:///./homeserve.db
DATABASE_URL="sqlite:///./homeserve.db"

# Super Admin Initial Provisioning
FIRST_SUPERADMIN_EMAIL="admin@homeserve.com"
FIRST_SUPERADMIN_PASSWORD="AdminPassword123!"
FIRST_SUPERADMIN_FIRSTNAME="Platform"
FIRST_SUPERADMIN_LASTNAME="Admin"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID="rzp_test_YourTestKeyId"
RAZORPAY_KEY_SECRET="YourRazorpayTestSecretKey"
PAYMENT_SIMULATION_ENABLED=True

# Cloudinary Media Storage (Before/After Job Images)
CLOUDINARY_CLOUD_NAME="demo-cloud"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# SMTP Mail Server (Optional)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="support@homeserve.local"
EMAILS_ENABLED=False

# ----------------- Frontend Configuration (frontend/.env) -----------------
VITE_API_URL="/api/v1"
VITE_APP_NAME="HomeServe Technologies"
VITE_RAZORPAY_KEY_ID="rzp_test_YourTestKeyId"

